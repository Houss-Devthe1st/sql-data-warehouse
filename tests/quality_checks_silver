/*
===============================================================================
Quality Checks
===============================================================================
Script Purpose:
    This script performs various quality checks for data consistency, accuracy, 
    and standardization across the 'silver' layer. It includes checks for:
    - Null or duplicate primary keys.
    - Unwanted spaces in string fields.
    - Data standardization and consistency.
    - Invalid date ranges and orders.
    - Data consistency between related fields.

Usage Notes:
    - Run these checks after data loading Silver Layer.
    - Investigate and resolve any discrepancies found during the checks.
===============================================================================
*/

--BRONZE LAYER: DATA QUALITY CHECKS
--check for duplicate IDs
select cst_id, count(*) ID_Count from bronze.crm_cust_info
group by cst_id 
having count(*) > 1 or cst_id is NULL
order by cst_id

--check unwanted first and last names and genders 
select cst_firstname from bronze.crm_cust_info
where cst_firstname != TRIM(cst_firstname)

select cst_lastname from bronze.crm_cust_info
where cst_lastname != TRIM(cst_lastname)

select cst_gndr from bronze.crm_cust_info
where cst_gndr != TRIM(cst_gndr)

select distinct cst_gndr from bronze.crm_cust_info
--F, M and NULL
--use more friendly way to represent those values with more meaningful values
--and replace NULL with standard value

select distinct cst_marital_status from bronze.crm_cust_info
--S, M and NULL. Same thing with gender

--check duplicate or null primary keys
select prd_id, count(*) ID_Count from bronze.crm_prd_info
group by prd_id 
having count(*) > 1 or prd_id is NULL
order by prd_id

--INSERT CORRECTED DATA INTO THE SILVER TABLE
insert into silver.crm_cust_info (
cst_id,
cst_key,
cst_firstname,
cst_lastname,
cst_marital_status,
cst_gndr,
cst_create_date)
select 
cst_id,
cst_key,
TRIM(cst_firstname) as cst_firstname,
TRIM(cst_lastname) as cst_lastname,
--standardization/normalization below
CASE 
	When UPPER(TRIM(cst_marital_status)) = 'S' THEN 'Single'
	When UPPER(TRIM(cst_marital_status)) = 'M' THEN 'Married'
	ELSE 'N/A'
END cst_marital_status,
--standardization/normalization below
CASE 
	When UPPER(TRIM(cst_gndr)) = 'F' THEN 'Female'
	When UPPER(TRIM(cst_gndr)) = 'M' THEN 'Male'
	ELSE 'N/A'
END cst_gndr,
cst_create_date
from (
select *, 
row_number() over (partition by cst_id order by cst_create_date desc) as flag_last
from bronze.crm_cust_info) t where flag_last = 1

