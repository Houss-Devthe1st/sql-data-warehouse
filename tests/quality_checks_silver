insert into silver.crm_sales_details (
	sls_ord_num ,
	sls_prd_key,
	sls_cust_id,
	sls_order_dt,
	sls_ship_dt,
	sls_due_dt,
	sls_sales,
	sls_quantity,
	sls_price
)
select 
sls_ord_num,
sls_prd_key,
sls_cust_id,
CASE WHEN
	sls_order_dt = 0 or len(sls_order_dt) != 8 THEN NULL
	ELSE CAST(CAST(sls_order_dt as varchar) as Date) --here we can't convert int to date
END as sls_order_dt, 
CASE WHEN
	sls_ship_dt = 0 or len(sls_ship_dt) != 8 THEN NULL
	ELSE CAST(CAST(sls_ship_dt as varchar) as Date) --here we can't convert int to date
END as sls_ship_dt, 
CASE WHEN
	sls_due_dt = 0 or len(sls_due_dt) != 8 THEN NULL
	ELSE CAST(CAST(sls_due_dt as varchar) as Date) --here we can't convert int to date
END as sls_due_dt, 
CASE 
	WHEN sls_sales <= 0 
		or sls_sales is NULL 
		or sls_sales != sls_quantity * ABS(sls_price) --ABS() converts every number from negative to positive
	THEN sls_quantity * ABS(sls_price)
	ELSE sls_sales
END as sls_sales,
sls_quantity,
CASE
	WHEN sls_price <= 0 or sls_price is NULL THEN sls_sales/nullif(sls_quantity,0)
	ELSE sls_price
END as sls_price
from bronze.crm_sales_details


--where sls_ord_num != TRIM(sls_ord_num) --0 results: all good
--where sls_prd_key not in (select prd_key from silver.crm_prd_info) --0 results: all good
--where sls_cust_id not in (select cst_id from silver.crm_cust_info) --0 results: all good

--check on the dates--
--format: integers, meaning they can be negatives or 0s
--length: dates should be 8 of length (yyyymmdd)
--Logic: order date < ship date < due date
select 
nullif(sls_order_dt, 0) as sls_order_dt
from silver.crm_sales_details
where (sls_order_dt <= 0 OR len(sls_order_dt) != 8 OR len(sls_order_dt) > 8)

select 
nullif(sls_ship_dt, 0) as sls_order_dt
from silver.crm_sales_details
where (sls_ship_dt <= 0 OR len(sls_ship_dt) != 8 OR len(sls_ship_dt) > 8)

select 
nullif(sls_due_dt, 0) as sls_order_dt
from silver.crm_sales_details
where (sls_due_dt <= 0 OR len(sls_due_dt) != 8 OR len(sls_due_dt) > 8)

select * from silver.crm_sales_details
where CAST(CAST(sls_order_dt as varchar) as Date) < CAST(CAST(sls_ship_dt as varchar) as Date)

select * from silver.crm_sales_details
where sls_order_dt > sls_ship_dt or sls_ship_dt > sls_due_dt or sls_order_dt > sls_due_dt

--check the calculations and sales numbers
-- sales, quantity and price could be negative or NULL
-- sales = quantity x price

--IF sales <= 0 or NULL ==> derive it using quantity and price
--IF price = 0 or NULL ==> calculate it using sales and quantity
--IF price < 0 ==> convert it to positive value
select
sls_sales,
sls_quantity,
sls_price
from silver.crm_sales_details
where (sls_sales <= 0 or sls_quantity <= 0 or sls_price <= 0)
or (sls_sales != sls_quantity * sls_price) 
or sls_sales is NULL or sls_quantity is NULL or sls_price is NULL

select * from silver.crm_sales_details
